# Sincronización entre dispositivos con Supabase (opcional).
# Copia este archivo como .env.local y rellena los valores de tu proyecto:
# Supabase → Project Settings → API → Project URL y la clave "anon" / "publishable".
# Sin estas variables la app funciona solo con los datos de este dispositivo.
# No subas nunca .env.local al repositorio (ya está en .gitignore).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dirección pública de la app (Vercel → Settings → Domains), p. ej. https://cifa.example.com
# Los enlaces /ficha/<token> para que un contacto rellene sus datos siempre la usan: las URLs de
# despliegue de Vercel están protegidas y el contacto no podría abrirlas.
VITE_PUBLIC_URL=

# Avisos a Mi Oficina (api/aviso-diario.js, cada mañana a las 07:00). SOLO en Vercel, nunca en .env.local:
# Supabase → Project Settings → API → clave "service_role" (secreta: lee todo saltándose RLS).
SUPABASE_SERVICE_ROLE_KEY=
MI_OFICINA_URL=
MI_OFICINA_CLAVE=
