# Sincronización entre dispositivos con Supabase (opcional).
# Copia este archivo como .env.local y rellena los valores de tu proyecto:
# Supabase → Project Settings → API → Project URL y la clave "anon" / "publishable".
# Sin estas variables la app funciona solo con los datos de este dispositivo.
# No subas nunca .env.local al repositorio (ya está en .gitignore).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recordatorios (notificaciones push). Clave PÚBLICA VAPID: la genera
# `node scripts/generate-vapid-keys.mjs`. La privada NUNCA va aquí: solo en los secretos de Supabase.
VITE_VAPID_PUBLIC_KEY=
